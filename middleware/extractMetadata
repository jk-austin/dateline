// Middleware function to extract metadata from the first page of the PDF text
function extractMetadata(text) {
  const headerMatch = 
    text.match(/Lancaster Farming,\s+\w+,\s+(\w+ \d+,\s+\d{4})\s+-\s+([A-Z])(\d+)/) ||
    text.match(/([A-Z])(\d+)\s+-\s+Lancaster Farming,\s+\w+,\s+(\w+ \d+,\s+\d{4})/);

  if (!headerMatch) {
    return null;
  }

    // Extracted values, place 0 is the full match, so we start from 1
  let rawDate, sectionLetter, pageNumber;

  if (headerMatch[0].startsWith('Lancaster')) {
    rawDate = headerMatch[1];
    sectionLetter = headerMatch[2];
    pageNumber = headerMatch[3].padStart(3, '0');
  } else {
    sectionLetter = headerMatch[1];
    pageNumber = headerMatch[2].padStart(3, '0');
    rawDate = headerMatch[3];
  }
  
  // Format the date as YYYYMMDD
  const date = new Date(rawDate);
  if (isNaN(date.getTime())) {
    return null;
  }

  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const formattedDate = `${year}${month}${day}`;

  // Map section letters to section names, need to update based on actual sections
  const sectionNames = {
    A: 'MAIN',
    B: 'FAMILY',
    C: 'BUSINESS',
    D: 'CLASSIFIEDS',
  };

  // Get the section name based on the section letter, default to 'UNKNOWN' if not found
  const sectionName = sectionNames[sectionLetter] || 'UNKNOWN';
  const filename = `LF_${formattedDate}_${sectionName}_${sectionLetter}_${pageNumber}.PDF`;

  // Return the extracted metadata as an object
  return { filename, formattedDate, sectionLetter, sectionName, pageNumber };
}

// Export the extractMetadata function for use in other parts of the application
module.exports = extractMetadata;